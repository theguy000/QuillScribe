import { ThemeColors } from "../themes/theme-definitions.slint";

export component HistoryPanel {
    in property <ThemeColors> theme-colors;

    callback refresh();

    Rectangle {
        background: theme-colors.bg_primary;

        VerticalLayout {
        padding: 24px;
        spacing: 16px;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "History";
                color: theme-colors.text_primary;
                font-size: 20px;
                font-weight: 700;
            }

            Rectangle {
                width: 80px;
                height: 32px;
                background: theme-colors.accent;
                border-radius: 6px;

                Text {
                    text: "Refresh";
                    color: theme-colors.on_accent;
                    font-size: 13px;
                }

                TouchArea {
                    clicked => { refresh(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: theme-colors.border;
        }

        Text {
            text: "History entries will appear here.";
            color: theme-colors.text_secondary;
            font-size: 14px;
        }
    }
    }
}
