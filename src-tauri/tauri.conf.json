{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuillScribe",
  "version": "0.1.2",
  "identifier": "com.quillscribe.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QuillScribe",
        "width": 960,
        "height": 560,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      },
      {
        "label": "overlay",
        "url": "/overlay.html",
        "title": "Recording",
        "width": 120,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.openai.com https://huggingface.co https://cdn-lfs.hf.co https://cdn-lfs-us-1.hf.co https://cdn-lfs.huggingface.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRDAzOEJBMzA1NkU2QTcKUldTbjVsWXd1ampRZnFPUFEzaENFbHFYYXJBS08rMDhBc1hQSHFPMGJpNTAxdjgwNUFaLzNON3kK",
      "endpoints": [
        "https://github.com/theguy000/QuillScribe/releases/latest/download/latest.json"
      ]
    }
  }
}
