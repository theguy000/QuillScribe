import { Theme, ThemeColors } from "themes/theme-definitions.slint";
import { TitleBar } from "components/titlebar.slint";
import { Sidebar } from "components/sidebar.slint";
import { RecordPanel } from "components/record-panel.slint";
import { TranscriptionPanel } from "components/transcription-panel.slint";
import { SettingsDialog } from "components/settings-dialog.slint";
import { BlocklistDeviceEntry } from "components/settings/blocklist-dialog.slint";
import { HistoryPanel, HistoryListEntry } from "components/history-panel.slint";
import { ToastContainer } from "components/toast.slint";
import { RecordingOverlay } from "recording-overlay.slint";

export { ThemeColors }
export { RecordingOverlay }

export component App inherits Window {
    in-out property <ThemeColors> theme-colors <=> Theme.current;
    in-out property <string> current-theme: "white";
    changed current-theme => {
        Theme.current = Theme.get-theme(self.current-theme);
        set-window-icon-theme(self.current-theme);
    }
    in-out property <bool> is-recording: false;
    in-out property <bool> is-transcribing: false;
    in-out property <string> transcription-text: "";
    in-out property <string> status-message: "Ready";
    in-out property <float> audio-level: 0;
    in-out property <bool> show-burst: false;
    in-out property <string> active-panel: "record";
    in-out property <bool> custom-titlebar: true;
    in-out property <bool> has-update: false;
    in-out property <int> session-count: 0;
    in-out property <[HistoryListEntry]> history-entries: [];
    in-out property <bool> history-loading: false;
    in-out property <string> history-error: "";
    in-out property <int> history-expanded-index: -1;

    // ── Settings: Audio ──────────────────────────────────────────────────
    in-out property <string> settings-audio-device-id;
    in-out property <bool> settings-sounds-enabled: true;
    changed settings-sounds-enabled => {
        settings-sounds-enabled-changed(self.settings-sounds-enabled);
    }
    in property <[string]> settings-audio-devices: ["Default"];
    in-out property <bool> settings-loading-devices: false;
    in-out property <bool> settings-testing-mic: false;
    in-out property <[string]> settings-audio-blocklist: [];
    in-out property <[BlocklistDeviceEntry]> settings-audio-blocklist-devices: [];


    // ── Settings: Whisper / Engine ────────────────────────────────────────
    in-out property <string> settings-whisper-mode: "api";
    in-out property <string> settings-api-provider: "openai";
    in-out property <string> settings-api-key;
    in-out property <string> settings-groq-api-key;
    in-out property <string> settings-gemini-api-key;
    // ── Settings: Deepgram (live session) ────────────────────────────────
    in-out property <string> settings-deepgram-api-key;
    in-out property <string> settings-deepgram-mode: "recorded";
    in-out property <bool> settings-deepgram-smart-format: true;    in-out property <bool> settings-deepgram-punctuate: true;
    in-out property <bool> settings-deepgram-dictation: false;
    in-out property <bool> settings-deepgram-interim-results: true;

    // Live typing. The screen only displays what the derived capability
    // decides, so `settings-live-typing` is the switch state, and its
    // availability, enabled state and reason all come from one answer.
    in-out property <bool> settings-live-typing: true;
    in property <bool> settings-live-typing-available: true;
    in property <bool> settings-live-typing-enabled: true;
    in property <string> settings-live-typing-reason: "";
    in property <string> settings-live-typing-description: "";
    in-out property <string> settings-api-model: "gpt-4o-transcribe";
    in-out property <string> settings-api-language: "en";
    in-out property <bool> settings-show-api-key: false;
    in-out property <string> settings-local-model: "base";
    in-out property <string> settings-local-model-category: "General";
    in-out property <bool> settings-model-downloaded: false;
    in-out property <bool> settings-downloading-model: false;
    in-out property <float> settings-download-progress: 0;
    in-out property <bool> settings-deleting-model: false;
    in-out property <string> settings-download-error;
    in property <string> settings-model-size;
    in property <string> settings-model-memory;
    in property <string> settings-model-speed;
    in property <string> settings-model-quality;
    in property <[string]> settings-api-providers: ["OpenAI", "Groq", "Gemini", "Deepgram"];
    in property <[string]> settings-api-models: ["gpt-4o-transcribe", "gpt-4o-mini-transcribe"];
    in property <[string]> settings-local-model-categories: ["General", "Tiny", "Base", "Small", "Medium", "Large"];
    in property <[string]> settings-local-models: ["tiny", "base", "small", "medium", "large"];
    in property <[string]> settings-languages: ["Auto-detect", "English", "Spanish", "French", "German", "Japanese", "Chinese"];

    // ── Settings: UI ─────────────────────────────────────────────────────
    in-out property <string> settings-theme: "white";
    in-out property <bool> settings-custom-titlebar: true;
    in-out property <bool> settings-always-on-top: false;
    in-out property <string> settings-overlay-mode: "minimal";
    in-out property <int> settings-max-history-entries: 100;
    in property <[string]> settings-themes: ["White", "Warm Gray", "Soft Beige", "Blue Gray", "Warm Taupe", "Soft Sage", "Dark Charcoal", "Dark Blue", "Dark Purple", "Dark Forest", "Dark Burgundy", "Obsidian"];
    in property <[string]> settings-overlay-modes: ["Minimal (bars only)", "Full (bars, timer, stop button)"];

    // ── Settings: Output ─────────────────────────────────────────────────
    in-out property <int> settings-output-mode: 2;
    in-out property <bool> settings-show-paste-tool-warning: false;
    in-out property <string> settings-paste-tool-hint;

    // ── Settings: Shortcuts ──────────────────────────────────────────────
    in-out property <string> settings-record-toggle-shortcut: "Meta+Shift+`";
    in-out property <bool> settings-recording-shortcut: false;

    // ── Settings: About ──────────────────────────────────────────────────
    in property <string> settings-app-version;
    in-out property <string> settings-update-version;
    in-out property <string> settings-update-notes;
    in-out property <bool> settings-update-checking: false;
    in-out property <bool> settings-update-downloading: false;
    in-out property <float> settings-update-progress: 0;
    in-out property <bool> settings-is-linux: false;
    in-out property <bool> settings-update-can-install: false;
    in-out property <string> settings-update-install-message;

    // ── Core callbacks — wired from Rust ─────────────────────────────────
    callback request-navigate(string);
    callback toggle-recording();
    callback copy-to-clipboard(string);
    callback load-history();
    callback check-for-update();
    callback install-update();
    callback drag-window();
    callback minimize-window();
    callback close-window();
    callback set-window-icon-theme(string);

    // ── Settings callbacks — wired from Rust ─────────────────────────────
    callback settings-refresh-audio-devices();
    callback settings-start-mic-test();
    callback settings-stop-mic-test();
    callback settings-audio-device-changed(string);
    callback settings-manage-blocklist();
    callback settings-add-blocklist-item(string);
    callback settings-remove-blocklist-item(int);
    callback settings-unhide-blocklist-device(string);
    callback settings-sounds-enabled-changed(bool);
    callback settings-mode-changed(string);
    callback settings-provider-changed(string);
    callback settings-api-key-changed(string);
    callback settings-groq-api-key-changed(string);
    callback settings-gemini-api-key-changed(string);
    callback settings-deepgram-api-key-changed(string);
    callback settings-deepgram-mode-changed(string);
    callback settings-deepgram-smart-format-changed(bool);
    callback settings-deepgram-punctuate-changed(bool);
    callback settings-deepgram-dictation-changed(bool);
    callback settings-deepgram-interim-results-changed(bool);
    callback settings-live-typing-changed(bool);
    callback settings-api-model-changed(string);
    callback settings-language-changed(string);
    callback settings-local-model-changed(string);
    callback settings-category-changed(string);
    callback settings-download-model();
    callback settings-delete-model();
    callback settings-toggle-api-key-visibility();
    callback settings-theme-changed(string);
    callback settings-custom-titlebar-changed(bool);
    callback settings-always-on-top-changed(bool);
    callback settings-overlay-mode-changed(string);
    callback settings-max-history-entries-changed(int);
    callback settings-output-mode-changed(int);
    callback settings-start-recording-shortcut();
    callback settings-stop-recording-shortcut();

    title: "QuillScribe";
    min-width: 860px;
    min-height: 640px;
    preferred-width: 1020px;
    preferred-height: 760px;
    background: theme-colors.bg_primary;
    no-frame: custom-titlebar;

    Rectangle {
        background: theme-colors.bg_primary;

        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, theme-colors.bg_secondary.with-alpha(0.7) 0%, theme-colors.bg_primary 24%);
        }

        Rectangle {
            width: parent.width * 2;
            height: parent.height * 2;
            x: -parent.width;
            y: -parent.height;
            background: @radial-gradient(circle, theme-colors.accent.with-alpha(0.07) 0%, transparent 28%);
        }

        VerticalLayout {
            if custom-titlebar: TitleBar {
                theme-colors: theme-colors;
                drag-window => { drag-window(); }
                minimize-window => { minimize-window(); }
                close-window => { close-window(); }
            }

            HorizontalLayout {
                padding: 22px;
                spacing: 22px;

                Sidebar {
                    theme-colors: theme-colors;
                    active-panel: active-panel;
                    has-update: has-update;
                    session-count: session-count;
                    navigate(panel) => { request-navigate(panel); }
                }

                Rectangle {
                    background: transparent;
                    clip: true;

                    if active-panel == "record": HorizontalLayout {
                        spacing: 18px;

                        RecordPanel {
                            theme-colors: theme-colors;
                            is-recording: is-recording;
                            is-transcribing: is-transcribing;
                            status-message: status-message;
                            audio-level: audio-level;
                            show-burst: show-burst;
                            toggle-recording => { toggle-recording(); }
                        }

                        TranscriptionPanel {
                            theme-colors: theme-colors;
                            text: transcription-text;
                            copy(text) => { copy-to-clipboard(text); }
                        }
                    }

                    if active-panel == "settings": SettingsDialog {
                        theme-colors: theme-colors;
                        width: 100%;
                        height: 100%;

                        // Audio
                        audio-device-id <=> settings-audio-device-id;
                        sounds-enabled <=> settings-sounds-enabled;
                        audio-devices: settings-audio-devices;
                        loading-devices: settings-loading-devices;
                        testing-mic: settings-testing-mic;
                        audio-level: audio-level;
                        audio-blocklist-devices: settings-audio-blocklist-devices;
                        refresh-audio-devices => { settings-refresh-audio-devices(); }
                        start-mic-test => { settings-start-mic-test(); }
                        stop-mic-test => { settings-stop-mic-test(); }
                        audio-device-changed(val) => { settings-audio-device-changed(val); }
                        manage-blocklist => { settings-manage-blocklist(); }
                        audio-blocklist: settings-audio-blocklist;
                        add-blocklist-item(val) => { settings-add-blocklist-item(val); }
                        remove-blocklist-item(idx) => { settings-remove-blocklist-item(idx); }
                        unhide-blocklist-device(id) => { settings-unhide-blocklist-device(id); }

                        // Whisper / Engine
                        whisper-mode <=> settings-whisper-mode;
                        api-provider <=> settings-api-provider;
                        api-key <=> settings-api-key;
                        groq-api-key <=> settings-groq-api-key;
                        gemini-api-key <=> settings-gemini-api-key;
                        deepgram-api-key <=> settings-deepgram-api-key;
                        deepgram-mode <=> settings-deepgram-mode;
                        deepgram-smart-format <=> settings-deepgram-smart-format;
                        deepgram-punctuate <=> settings-deepgram-punctuate;
                        deepgram-dictation <=> settings-deepgram-dictation;
                        deepgram-interim-results <=> settings-deepgram-interim-results;
                        live-typing <=> settings-live-typing;
                        live-typing-available: settings-live-typing-available;
                        live-typing-enabled: settings-live-typing-enabled;
                        live-typing-reason: settings-live-typing-reason;
                        live-typing-description: settings-live-typing-description;
                        api-model <=> settings-api-model;
                        api-language <=> settings-api-language;
                        show-api-key <=> settings-show-api-key;
                        local-model <=> settings-local-model;
                        local-model-category <=> settings-local-model-category;
                        model-downloaded <=> settings-model-downloaded;
                        downloading-model <=> settings-downloading-model;
                        download-progress <=> settings-download-progress;
                        deleting-model <=> settings-deleting-model;
                        download-error <=> settings-download-error;
                        model-size: settings-model-size;
                        model-memory: settings-model-memory;
                        model-speed: settings-model-speed;
                        model-quality: settings-model-quality;
                        api-providers: settings-api-providers;
                        api-models: settings-api-models;
                        local-model-categories: settings-local-model-categories;
                        local-models: settings-local-models;
                        languages: settings-languages;
                        mode-changed(val) => { settings-mode-changed(val); }
                        provider-changed(val) => { settings-provider-changed(val); }
                        api-key-changed(val) => { settings-api-key-changed(val); }
                        groq-api-key-changed(val) => { settings-groq-api-key-changed(val); }
                        gemini-api-key-changed(val) => { settings-gemini-api-key-changed(val); }
                        deepgram-api-key-changed(val) => { settings-deepgram-api-key-changed(val); }
                        deepgram-mode-changed(val) => { settings-deepgram-mode-changed(val); }
                        deepgram-smart-format-changed(val) => { settings-deepgram-smart-format-changed(val); }
                        deepgram-punctuate-changed(val) => { settings-deepgram-punctuate-changed(val); }
                        deepgram-dictation-changed(val) => { settings-deepgram-dictation-changed(val); }
                        deepgram-interim-results-changed(val) => { settings-deepgram-interim-results-changed(val); }
                        live-typing-changed(val) => { settings-live-typing-changed(val); }
                        api-model-changed(val) => { settings-api-model-changed(val); }
                        language-changed(val) => { settings-language-changed(val); }
                        local-model-changed(val) => { settings-local-model-changed(val); }
                        category-changed(val) => { settings-category-changed(val); }
                        download-model => { settings-download-model(); }
                        delete-model => { settings-delete-model(); }
                        toggle-api-key-visibility => { settings-toggle-api-key-visibility(); }

                        // UI
                        theme <=> settings-theme;
                        custom-titlebar <=> settings-custom-titlebar;
                        always-on-top <=> settings-always-on-top;
                        overlay-mode <=> settings-overlay-mode;
                        max-history-entries <=> settings-max-history-entries;
                        themes: settings-themes;
                        overlay-modes: settings-overlay-modes;
                        theme-changed(val) => { settings-theme-changed(val); }
                        custom-titlebar-changed(val) => { settings-custom-titlebar-changed(val); }
                        always-on-top-changed(val) => { settings-always-on-top-changed(val); }
                        overlay-mode-changed(val) => { settings-overlay-mode-changed(val); }
                        max-history-entries-changed(val) => { settings-max-history-entries-changed(val); }

                        // Output
                        output-mode <=> settings-output-mode;
                        show-paste-tool-warning <=> settings-show-paste-tool-warning;
                        paste-tool-hint <=> settings-paste-tool-hint;
                        output-mode-changed(val) => { settings-output-mode-changed(val); }

                        // Shortcuts
                        record-toggle-shortcut <=> settings-record-toggle-shortcut;
                        recording-shortcut <=> settings-recording-shortcut;
                        start-recording-shortcut => { settings-start-recording-shortcut(); }
                        stop-recording-shortcut => { settings-stop-recording-shortcut(); }

                        // About
                        app-version: settings-app-version;
                        has-update <=> has-update;
                        update-version <=> settings-update-version;
                        update-notes <=> settings-update-notes;
                        update-checking <=> settings-update-checking;
                        update-downloading <=> settings-update-downloading;
                        update-progress <=> settings-update-progress;
                        is-linux <=> settings-is-linux;
                        update-can-install <=> settings-update-can-install;
                        update-install-message <=> settings-update-install-message;
                        check-for-update => { check-for-update(); }
                        install-update => { install-update(); }
                    }

                    if active-panel == "history": HistoryPanel {
                        theme-colors: theme-colors;
                        width: 100%;
                        height: 100%;
                        entries: history-entries;
                        loading: history-loading;
                        error-message: history-error;
                        expanded-index <=> history-expanded-index;
                        refresh => { load-history(); }
                        copy(text) => { copy-to-clipboard(text); }
                    }
                }
            }
        }

        toast_container := ToastContainer {
            theme-colors: theme-colors;
        }
    }
}
