// QuillScribe Theme Definitions
// All 12 themes with complete color palettes

export struct ThemeColors {
    bg_primary: color,
    bg_secondary: color,
    bg_tertiary: color,
    text_primary: color,
    text_secondary: color,
    text_muted: color,
    accent: color,
    accent_hover: color,
    accent_glow: color,
    border: color,
    border_light: color,
    shadow: color,
    shadow_lg: color,
    danger: color,
    danger_hover: color,
    success: color,
    warning: color,
    warning_hover: color,
    on_accent: color,
    on_danger: color,
    highlight: color,
    recording_glow: color,
    scrollbar_track: color,
    scrollbar_thumb: color,
    titlebar_bg: color,
    titlebar_text: color,
}

export global Theme {
    in-out property <ThemeColors> current: white-theme();

    // ── White (default light) ───────────────────────────────────────────
    pure function white-theme() -> ThemeColors {
        {
            bg_primary: #f6f8fb,
            bg_secondary: #eef2f7,
            bg_tertiary: #e4eaf2,
            text_primary: #162033,
            text_secondary: #5a667c,
            text_muted: #8c97aa,
            accent: #2563eb,
            accent_hover: #1d4ed8,
            accent_glow: #2563eb33,
            border: #ccd6e3,
            border_light: #dde5ef,
            shadow: #0f172a14,
            shadow_lg: #0f172a24,
            danger: #e81123,
            danger_hover: #c82333,
            success: #34c759,
            warning: #e5a000,
            warning_hover: #cc8f00,
            on_accent: #ffffff,
            on_danger: #ffffff,
            highlight: #ffffff52,
            recording_glow: #e74c3c66,
            scrollbar_track: #e8edf5,
            scrollbar_thumb: #b4c0d0,
            titlebar_bg: #f7f9fc,
            titlebar_text: #22304a,
