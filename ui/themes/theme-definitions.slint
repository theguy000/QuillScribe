    // ── Theme lookup by key ──────────────────────────────────────────
    public pure function get-theme(key: string) -> ThemeColors {
        if key == "white" { return white-theme(); }
        if key == "warm_gray" { return warm-gray-theme(); }
        if key == "soft_beige" { return soft-beige-theme(); }
        if key == "blue_gray" { return blue-gray-theme(); }
        if key == "warm_taupe" { return warm-taupe-theme(); }
        if key == "soft_sage" { return soft-sage-theme(); }
        if key == "dark_charcoal" { return dark-charcoal-theme(); }
        if key == "dark_blue" { return dark-blue-theme(); }
        if key == "dark_purple" { return dark-purple-theme(); }
        if key == "dark_forest" { return dark-forest-theme(); }
        if key == "dark_burgundy" { return dark-burgundy-theme(); }
        if key == "obsidian" { return obsidian-theme(); }
        return white-theme();
    }
}

