import { ThemeColors } from "../themes/theme-definitions.slint";
import { AudioTab } from "settings/audio-tab.slint";
import { BlocklistDialog, BlocklistDeviceEntry } from "settings/blocklist-dialog.slint";
import { WhisperTab } from "settings/whisper-tab.slint";
import { UiTab } from "settings/ui-tab.slint";
import { OutputTab } from "settings/output-tab.slint";
import { KeyboardTab } from "settings/keyboard-tab.slint";
import { AboutTab } from "settings/about-tab.slint";

component TabButton inherits Rectangle {
    in property <string> tab-id;
    in property <string> label;
    in property <ThemeColors> theme-colors;
    in-out property <string> active-tab;

    horizontal-stretch: 0;

    clickable := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { active-tab = tab-id; }
        mouse-cursor: pointer;
    }

    background: clickable.has-hover ? theme-colors.bg_tertiary : transparent;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;

            Text {
                text: label;
                color: active-tab == tab-id ? theme-colors.accent : (clickable.has-hover ? theme-colors.text_primary : theme-colors.text_secondary);
                font-size: 12.5px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 2px;
            background: active-tab == tab-id ? theme-colors.accent : transparent;
        }
    }
}


export component SettingsDialog inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in-out property <string> active-tab: "audio";

    // Audio tab properties
    in-out property <string> audio-device-id;
    in-out property <bool> sounds-enabled: true;
    in property <[string]> audio-devices: ["Default"];
    in property <bool> loading-devices: false;
    in property <bool> testing-mic;
    in property <float> audio-level;
    in property <[string]> audio-blocklist: [];
    in property <[BlocklistDeviceEntry]> audio-blocklist-devices: [];

    // Whisper tab properties
    in-out property <string> whisper-mode: "api";
    in-out property <string> api-provider: "openai";
    in-out property <string> api-key;
    in-out property <string> groq-api-key;
    in-out property <string> api-model: "gpt-4o-transcribe";
    in-out property <string> api-language: "en";
    in-out property <bool> show-api-key: false;
    in-out property <string> local-model: "base";
    in-out property <string> local-model-category: "General";
    in-out property <bool> model-downloaded: false;
    in-out property <bool> downloading-model: false;
    in property <float> download-progress: 0;
    in-out property <bool> deleting-model: false;
    in-out property <string> download-error;
    in property <string> model-size;
    in property <string> model-memory;
    in property <string> model-speed;
    in property <string> model-quality;
    in property <[string]> api-providers: ["OpenAI", "Groq"];
    in property <[string]> api-models: ["gpt-4o-transcribe", "whisper-1"];
    in property <[string]> local-model-categories: ["General", "Tiny", "Base", "Small", "Medium", "Large"];
    in property <[string]> local-models: ["tiny", "base", "small", "medium", "large"];
    in property <[string]> languages: ["Auto-detect", "English", "Spanish", "French", "German", "Japanese", "Chinese"];

    // UI tab properties
    in-out property <string> theme: "white";
    in-out property <bool> custom-titlebar: true;
    in-out property <bool> always-on-top: false;
    in-out property <string> overlay-mode: "minimal";
    in-out property <int> max-history-entries: 100;
    in property <[string]> themes: ["White", "Warm Gray", "Soft Beige", "Blue Gray", "Warm Taupe", "Soft Sage", "Dark Charcoal", "Dark Blue", "Dark Purple", "Dark Forest", "Dark Burgundy", "Obsidian"];
    in property <[string]> overlay-modes: ["Minimal (bars only)", "Full (bars, timer, stop button)"];

    // Output tab properties
    in-out property <int> output-mode: 2;
    in-out property <bool> show-paste-tool-warning: false;
    in-out property <string> paste-tool-hint;

    // Shortcut tab properties
    in-out property <string> record-toggle-shortcut: "Meta+Shift+`";
    in-out property <bool> recording-shortcut: false;

    // About tab properties
    in property <string> app-version;
    in-out property <bool> has-update: false;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <bool> update-checking: false;
    in-out property <bool> update-downloading: false;
    in-out property <float> update-progress: 0;
    in-out property <bool> is-linux: false;

    // Callbacks
    callback refresh-audio-devices();
    callback start-mic-test();
    callback stop-mic-test();
    callback audio-device-changed(string);
    callback manage-blocklist();
    callback add-blocklist-item(string);
    callback remove-blocklist-item(int);
    callback unhide-blocklist-device(string);
    callback mode-changed(string);
    callback provider-changed(string);
    callback api-key-changed(string);
    callback api-model-changed(string);
    callback language-changed(string);
    callback local-model-changed(string);
    callback category-changed(string);
    callback download-model();
    callback delete-model();
    callback toggle-api-key-visibility();
    callback theme-changed(string);
    callback custom-titlebar-changed(bool);
    callback always-on-top-changed(bool);
    callback overlay-mode-changed(string);
    callback max-history-entries-changed(int);
    callback output-mode-changed(int);
    callback start-recording-shortcut();
    callback stop-recording-shortcut();
    callback check-for-update();
    callback install-update();

    background: theme-colors.bg_primary;
    border-radius: 22px;
    border-width: 1px;
    border-color: theme-colors.border_light;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Header
        Rectangle {
            vertical-stretch: 0;
            background: theme-colors.bg_primary;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 24px;
                padding-bottom: 18px;

                Text {
                    text: "Settings";
                    color: theme-colors.text_primary;
                    font-size: 22px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: theme-colors.border_light;
                y: parent.height - 1px;
                width: parent.width;
            }
        }

        // Tab bar
        Rectangle {
            vertical-stretch: 0;
            background: theme-colors.bg_primary;

            HorizontalLayout {
                padding-left: 26px;
                padding-right: 26px;
                spacing: 2px;

                TabButton { tab-id: "audio"; label: "Audio"; active-tab <=> active-tab; theme-colors: theme-colors; }
                TabButton { tab-id: "whisper"; label: "Engine"; active-tab <=> active-tab; theme-colors: theme-colors; }
                TabButton { tab-id: "ui"; label: "UI"; active-tab <=> active-tab; theme-colors: theme-colors; }
                TabButton { tab-id: "output"; label: "Output"; active-tab <=> active-tab; theme-colors: theme-colors; }
                TabButton { tab-id: "keyboard"; label: "Shortcuts"; active-tab <=> active-tab; theme-colors: theme-colors; }
                TabButton { tab-id: "about"; label: "About"; active-tab <=> active-tab; theme-colors: theme-colors; }

                Rectangle {}
            }

            Rectangle {
                height: 1px;
                background: theme-colors.border_light;
                y: parent.height - 1px;
                width: parent.width;
            }
        }

        // Tab content
        Rectangle {
            background: theme-colors.bg_primary;
            clip: true;
            vertical-stretch: 1;

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 16px;

                Rectangle {
                    background: theme-colors.bg_primary;
                    border-radius: 12px;
                    clip: true;
                    vertical-stretch: 1;

                    flick := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: content.preferred-height;
                        viewport-width: flick.width;

                        content := VerticalLayout {
                            width: 100%;
                            padding: 12px;

                            if active-tab == "audio": AudioTab {
                                theme-colors: theme-colors;
                                audio-device-id <=> audio-device-id;
                                sounds-enabled <=> sounds-enabled;
                                audio-devices: audio-devices;
                                loading-devices: loading-devices;
                                testing-mic: testing-mic;
                                audio-level: audio-level;
                                blocklist-devices: audio-blocklist-devices;
                                refresh-audio-devices => { refresh-audio-devices(); }
                                start-mic-test => { start-mic-test(); }
                                stop-mic-test => { stop-mic-test(); }
                                audio-device-changed(val) => { audio-device-changed(val); }
                                manage-blocklist => {
                                    blocklist-popup.show();
                                    manage-blocklist();
                                }
                                blocklist: audio-blocklist;
                                add-blocklist-item(val) => { add-blocklist-item(val); }
                                remove-blocklist-item(idx) => { remove-blocklist-item(idx); }
                                unhide-blocklist-device(id) => { unhide-blocklist-device(id); }
                            }

                            if active-tab == "whisper": WhisperTab {
                                theme-colors: theme-colors;
                                whisper-mode: whisper-mode;
                                api-provider: api-provider;
                                api-key: api-key;
                                groq-api-key: groq-api-key;
                                api-model: api-model;
                                api-language: api-language;
                                show-api-key: show-api-key;
                                local-model: local-model;
                                local-model-category: local-model-category;
                                model-downloaded: model-downloaded;
                                downloading-model: downloading-model;
                                download-progress: download-progress;
                                deleting-model: deleting-model;
                                download-error: download-error;
                                model-size: model-size;
                                model-memory: model-memory;
                                model-speed: model-speed;
                                model-quality: model-quality;
                                api-providers: api-providers;
                                api-models: api-models;
                                local-model-categories: local-model-categories;
                                local-models: local-models;
                                languages: languages;
                                mode-changed(val) => { mode-changed(val); }
                                provider-changed(val) => { provider-changed(val); }
                                api-key-changed(val) => { api-key-changed(val); }
                                api-model-changed(val) => { api-model-changed(val); }
                                language-changed(val) => { language-changed(val); }
                                local-model-changed(val) => { local-model-changed(val); }
                                category-changed(val) => { category-changed(val); }
                                download-model => { download-model(); }
                                delete-model => { delete-model(); }
                                toggle-api-key-visibility => { toggle-api-key-visibility(); }
                            }

                            if active-tab == "ui": UiTab {
                                theme-colors: theme-colors;
                                theme: theme;
                                custom-titlebar: custom-titlebar;
                                always-on-top: always-on-top;
                                overlay-mode: overlay-mode;
                                max-history-entries <=> max-history-entries;
                                themes: themes;
                                overlay-modes: overlay-modes;
                                theme-changed(val) => { theme-changed(val); }
                                custom-titlebar-changed(val) => { custom-titlebar-changed(val); }
                                always-on-top-changed(val) => { always-on-top-changed(val); }
                                overlay-mode-changed(val) => { overlay-mode-changed(val); }
                                max-history-entries-changed(val) => { max-history-entries-changed(val); }
                            }

                            if active-tab == "output": OutputTab {
                                theme-colors: theme-colors;
                                output-mode: output-mode;
                                show-paste-tool-warning: show-paste-tool-warning;
                                paste-tool-hint: paste-tool-hint;
                                output-mode-changed(val) => { output-mode-changed(val); }
                            }

                            if active-tab == "keyboard": KeyboardTab {
                                theme-colors: theme-colors;
                                record-toggle-shortcut: record-toggle-shortcut;
                                recording-shortcut: recording-shortcut;
                                start-recording-shortcut => { start-recording-shortcut(); }
                                stop-recording-shortcut => { stop-recording-shortcut(); }
                            }

                            if active-tab == "about": AboutTab {
                                theme-colors: theme-colors;
                                app-version: app-version;
                                has-update: has-update;
                                update-version: update-version;
                                update-notes: update-notes;
                                update-checking: update-checking;
                                update-downloading: update-downloading;
                                update-progress: update-progress;
                                is-linux: is-linux;
                                check-for-update => { check-for-update(); }
                                install-update => { install-update(); }
                            }
                        }
                    }

                    // Custom Scrollbar
                    if flick.viewport-height > flick.height: Rectangle {
                        width: 5px;
                        height: flick.height * (flick.height / flick.viewport-height);
                        y: (-flick.viewport-y) * (flick.height / flick.viewport-height);
                        x: parent.width - 8px;
                        background: theme-colors.scrollbar_thumb;
                        border-radius: 3px;
                    }
                }
            }
        }
    }

    blocklist-popup := PopupWindow {
        width: Math.min(root.width - 48px, 520px);
        height: Math.min(root.height - 48px, 560px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;

        BlocklistDialog {
            width: 100%;
            height: 100%;
            theme-colors: theme-colors;
            blocklist: audio-blocklist;
            devices: audio-blocklist-devices;
            add-item(val) => { add-blocklist-item(val); }
            remove-item(idx) => { remove-blocklist-item(idx); }
            unhide-device(id) => { unhide-blocklist-device(id); }
            close => { blocklist-popup.close(); }
        }
    }
}
