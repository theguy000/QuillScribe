import { ThemeColors } from "../themes/theme-definitions.slint";

component TabButton inherits Rectangle {
    in property <string> tab-id;
    in property <string> label;
    in property <ThemeColors> theme-colors;
    in-out property <string> active-tab;

    clickable := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { active-tab = tab-id; }
    }

    background: clickable.has-hover ? theme-colors.bg_tertiary : transparent;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 8px;

            Text {
                text: label;
                color: active-tab == tab-id ? theme-colors.accent : (clickable.has-hover ? theme-colors.text_primary : theme-colors.text_secondary);
                font-size: 12.5px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 2px;
            background: active-tab == tab-id ? theme-colors.accent : transparent;
        }
    }
}


component TabContentPlaceholder inherits VerticalLayout {
    in property <string> message;
    in property <ThemeColors> theme-colors;

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 16px;
    spacing: 14px;

    Text {
        text: message;
        color: theme-colors.text_secondary;
        font-size: 13px;
    }
}

export component SettingsDialog {
    in property <ThemeColors> theme-colors;
    in-out property <string> active-tab: "audio";

    Rectangle {
        background: theme-colors.bg_primary;
        border-radius: 22px;
        border-width: 1px;
        border-color: theme-colors.border_light;
        clip: true;

        VerticalLayout {
            spacing: 0px;

            // Header
            Rectangle {
                background: theme-colors.bg_primary;

                HorizontalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 24px;
                    padding-bottom: 18px;

                    Text {
                        text: "Settings";
                        color: theme-colors.text_primary;
                        font-size: 22px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: theme-colors.border_light;
                    y: parent.height - 1px;
                    width: parent.width;
                }
            }

            // Tab bar
            Rectangle {
                background: theme-colors.bg_primary;

                HorizontalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    spacing: 2px;

                    TabButton { tab-id: "audio"; label: "Audio"; active-tab: active-tab; theme-colors: theme-colors; }
                    TabButton { tab-id: "whisper"; label: "Engine"; active-tab: active-tab; theme-colors: theme-colors; }
                    TabButton { tab-id: "ui"; label: "UI"; active-tab: active-tab; theme-colors: theme-colors; }
                    TabButton { tab-id: "output"; label: "Output"; active-tab: active-tab; theme-colors: theme-colors; }
                    TabButton { tab-id: "keyboard"; label: "Keyboard"; active-tab: active-tab; theme-colors: theme-colors; }
                    TabButton { tab-id: "about"; label: "About"; active-tab: active-tab; theme-colors: theme-colors; }
                }

                Rectangle {
                    height: 1px;
                    background: theme-colors.border_light;
                    y: parent.height - 1px;
                    width: parent.width;
                }
            }

            // Tab content
            Rectangle {
                background: theme-colors.bg_primary;
                clip: true;

                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 16px;
                    padding-bottom: 16px;

                    Rectangle {
                        background: theme-colors.bg_secondary;
                        border-radius: 12px;
                        clip: true;

                        if active-tab == "audio": TabContentPlaceholder { message: "Audio settings will be implemented here."; theme-colors: theme-colors; }
                        if active-tab == "whisper": TabContentPlaceholder { message: "Engine settings will be implemented here."; theme-colors: theme-colors; }
                        if active-tab == "ui": TabContentPlaceholder { message: "UI settings will be implemented here."; theme-colors: theme-colors; }
                        if active-tab == "output": TabContentPlaceholder { message: "Output settings will be implemented here."; theme-colors: theme-colors; }
                        if active-tab == "keyboard": TabContentPlaceholder { message: "Keyboard settings will be implemented here."; theme-colors: theme-colors; }
                        if active-tab == "about": TabContentPlaceholder { message: "About information will be implemented here."; theme-colors: theme-colors; }
                    }
                }
            }
        }
    }
}
