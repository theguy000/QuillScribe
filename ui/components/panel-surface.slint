import { ThemeColors } from "../themes/theme-definitions.slint";

export component PanelSurface {
    in property <ThemeColors> theme-colors;

    Rectangle {
        background: theme-colors.bg_primary;
        border-radius: 18px;
        border-width: 1px;
        border-color: theme-colors.border_light.with-alpha(0.95);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(180deg, theme-colors.bg_primary.with-alpha(0.9) 0%, theme-colors.bg_secondary.with-alpha(0.92) 100%);
        }

        Rectangle {
            width: parent.width * 2;
            height: parent.height * 2;
            x: -parent.width / 2;
            y: -parent.height;
            border-radius: parent.border-radius;
            background: @radial-gradient(circle, theme-colors.accent.with-alpha(0.18) 0%, transparent 42%);
        }

        @children
    }
}
