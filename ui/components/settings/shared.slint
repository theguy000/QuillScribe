import { ThemeColors } from "../../themes/theme-definitions.slint";

// ── Reusable settings field components ──────────────────────────────────────

export component SettingsField inherits VerticalLayout {
    in property <ThemeColors> theme-colors;
    in property <string> label;
    spacing: 6px;

    Text {
        text: label;
        color: theme-colors.text_primary;
        font-size: 12px;
        font-weight: 600;
    }

    // Children go here (the actual input control)
}

export component SettingsHint inherits Text {
    in property <ThemeColors> theme-colors;
    color: theme-colors.text_muted;
    font-size: 11px;
    wrap: word-wrap;
}

export component SettingsSelect inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in-out property <string> current-value;
    in property <[string]> options;
    in-out property <bool> is-open: false;
    callback value-changed(string);

    forward-focus: trigger-fs;

    function close-dropdown() {
        popup.close();
    }

    function open-dropdown() {
        trigger-fs.focus();
        popup.show();
    }

    width: 240px;
    height: 28px;

    function pick-value() -> string {
        if current-value != "" {
            return current-value;
        }
        if options.length > 0 {
            return options[0];
        }
        return "";
    }

    trigger-fs := FocusScope {
        width: 100%;
        height: 100%;

        changed has-focus => {
            if self.has-focus {
                is-open = false;
            }
        }

        // Trigger button
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 6px;
            background: theme-colors.bg_tertiary;
            border-width: 1px;
            border-color: theme-colors.border_light;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                Text {
                    text: root.pick-value();
                    color: theme-colors.text_primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                // Dropdown chevron
                Image {
                    source: @image-url("chevron-down.svg");
                    colorize: theme-colors.text_muted;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-rotation: is-open ? 180deg : 0deg;
                    animate transform-rotation { duration: 200ms; easing: ease-out; }
                }
            }

            touch_main := TouchArea {
                clicked => {
                    trigger-fs.focus();
                    if is-open {
                        close-dropdown();
                    } else if options.length > 0 {
                        open-dropdown();
                    }
                }
                mouse-cursor: pointer;
            }

            // Dropdown list popup
            popup := PopupWindow {
                x: 0px;
                y: 30px;
                width: root.width;
                height: Math.min(options.length, 5) * 26px + 8px;
                close-policy: close-on-click-outside;
                forward-focus: popup-fs;

                popup-fs := FocusScope {
                    focus-changed-event => {
                        if self.has-focus {
                            is-open = true;
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 6px;
                        background: theme-colors.bg_secondary;
                        border-width: 1px;
                        border-color: theme-colors.border_light;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: theme-colors.shadow_lg;
                        drop-shadow-offset-y: 4px;
                        clip: true;

                        flick := Flickable {
                            viewport-height: options.length * 26px + 8px;
                            interactive: true;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;

                                for option[idx] in options: Rectangle {
                                    width: 100%;
                                    height: 26px;
                            border-radius: 4px;
                            background: option == root.pick-value() ? theme-colors.accent_glow : (touch_option.has-hover ? theme-colors.bg_tertiary : transparent);

                            Text {
                                text: option;
                                color: option == root.pick-value() ? theme-colors.accent : theme-colors.text_primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                x: 10px;
                            }

                            touch_option := TouchArea {
                                clicked => {
                                    current-value = option;
                                    value-changed(option);
                                    close-dropdown();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // Custom Scrollbar (draggable)
                scrollbar_touch := TouchArea {
                    x: parent.width - 10px;
                    y: 0px;
                    width: 10px;
                    height: flick.height;
                    mouse-cursor: pointer;
                    visible: flick.viewport-height > flick.height;

                    property <length> drag-start-y: 0px;
                    property <length> drag-start-viewport: 0px;

                    property <bool> is-pressed: false;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            is-pressed = true;
                            drag-start-y = self.mouse-y;
                            drag-start-viewport = flick.viewport-y;
                        } else if event.kind == PointerEventKind.up {
                            is-pressed = false;
                        }
                    }

                    moved => {
                        if is-pressed {
                            let delta = self.mouse-y - drag-start-y;
                            let ratio = flick.viewport-height / flick.height;
                            let max-scroll = flick.viewport-height - flick.height;
                            flick.viewport-y = Math.max(0px, Math.min(drag-start-viewport + delta * ratio, max-scroll));
                        }
                    }

                    // Visual thumb
                    Rectangle {
                        width: 4px;
                        height: flick.height * (flick.height / flick.viewport-height);
                        y: -flick.viewport-y * (flick.height / flick.viewport-height);
                        x: (parent.width - self.width) / 2;
                        border-radius: 2px;
                        background: theme-colors.border;
                    }
                }
            }
        }
    }
        }
    }
}

export component SettingsCheckbox inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in property <string> label;
    in-out property <bool> checked;
    callback toggled();

    height: 28px;
    width: 100%;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        // Checkbox indicator
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1px;
            border-color: checked ? theme-colors.accent : theme-colors.border;
            background: checked ? theme-colors.accent : transparent;
            y: (parent.height - self.height) / 2;

            Text {
                text: "✓";
                color: theme-colors.on_accent;
                font-size: 12px;
                visible: checked;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: label;
            color: theme-colors.text_primary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            checked = !checked;
            toggled();
        }
        mouse-cursor: pointer;
    }
}

export component SettingsRadioOption inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in property <string> label;
    in property <string> description;
    in property <bool> selected;
    callback selected-changed();

    height: description != "" ? 44px : 28px;
    width: 100%;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        // Radio indicator
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            border-width: 2px;
            border-color: selected ? theme-colors.accent : theme-colors.border;
            y: 4px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: theme-colors.accent;
                visible: selected;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: label;
                color: selected ? theme-colors.text_primary : theme-colors.text_secondary;
                font-size: 12px;
                font-weight: selected ? 600 : 400;
            }

            if description != "": Text {
                text: description;
                color: theme-colors.text_muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    TouchArea {
        clicked => { selected-changed(); }
        mouse-cursor: pointer;
    }
}

export component SettingsButton inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    width: 100%;
    border-radius: 6px;

    background: disabled ? theme-colors.bg_tertiary
              : danger ? theme-colors.danger
              : primary ? theme-colors.accent
              : theme-colors.bg_tertiary;

    border-width: 1px;
    border-color: disabled ? theme-colors.border_light
                 : danger ? theme-colors.danger
                 : primary ? theme-colors.accent
                 : theme-colors.border;

    Text {
        text: label;
        color: disabled ? theme-colors.text_muted
             : (primary || danger) ? theme-colors.on_accent
             : theme-colors.text_primary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { if !disabled { clicked(); } }
        mouse-cursor: disabled ? not-allowed : pointer;
    }
}

export component SettingsInput inherits HorizontalLayout {
    in property <ThemeColors> theme-colors;
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;

    alignment: start;

    Rectangle {
        width: 240px;
        height: 28px;
        border-radius: 6px;
        background: theme-colors.bg_tertiary;
        border-width: 1px;
        border-color: field.has-focus ? theme-colors.accent : theme-colors.border_light;

        field := TextInput {
            text <=> root.text;
            color: theme-colors.text_primary;
            font-size: 12px;
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            vertical-alignment: center;
            input-type: root.input-type;
        }
    }
}

export component StepButton inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in property <string> symbol;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: theme-colors.bg_tertiary;
    border-width: 1px;
    border-color: theme-colors.border_light;

    Text {
        text: symbol;
        color: theme-colors.text_primary;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { clicked(); }
        mouse-cursor: pointer;
    }
}

export component SettingsSlider inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;

    height: 24px;
    width: 100%;

    Rectangle {
        y: 10px;
        width: 100%;
        height: 4px;
        border-radius: 2px;
        background: theme-colors.bg_tertiary;

        Rectangle {
            width: parent.width * (value - minimum) / (maximum - minimum);
            height: 100%;
            border-radius: 2px;
            background: theme-colors.accent;
        }
    }

    // Thumb
    Rectangle {
        x: parent.width * (value - minimum) / (maximum - minimum) - 7px;
        y: 5px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: theme-colors.accent;
    }

    function update-value(mouse-x: length) {
        value = minimum + mouse-x / self.width * (maximum - minimum);
        if value < minimum { value = minimum; }
        if value > maximum { value = maximum; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed { root.update-value(self.mouse-x); }
        }
        clicked => {
            root.update-value(self.mouse-x);
        }
    }
}
