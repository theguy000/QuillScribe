import { ThemeColors } from "../../themes/theme-definitions.slint";
import { SettingsField, SettingsHint, SettingsInput, SettingsButton } from "shared.slint";

export struct BlocklistDeviceEntry {
    name: string,
    id: string,
    blocked: bool,
    blocked_by: string,
}

export component BlocklistDialog inherits Rectangle {
    in property <ThemeColors> theme-colors;
    in property <[string]> blocklist;
    in property <[BlocklistDeviceEntry]> devices;
    
    callback add-item(string);
    callback remove-item(int);
    callback unhide-device(string);
    callback close();

    property <string> new-item-text;

    preferred-width: 520px;
    preferred-height: 560px;
    background: theme-colors.bg_secondary;
    border-radius: 16px;
    border-width: 1px;
    border-color: theme-colors.border;
    drop-shadow-blur: 20px;
    drop-shadow-color: theme-colors.shadow_lg;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Manage Blocklist";
                color: theme-colors.text_primary;
                font-size: 16px;
                font-weight: 600;
            }
            
            // Close button
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: close-touch.has-hover ? theme-colors.bg_tertiary : transparent;
                
                Text {
                    text: "✕";
                    width: 100%;
                    height: 100%;
                    color: theme-colors.text_secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                close-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.close(); }
                    mouse-cursor: pointer;
                }
            }
        }

        SettingsHint {
            theme-colors: theme-colors;
            text: "Hide detected input devices from the microphone selector, or manage the saved match patterns below.";
        }

        Text {
            text: "Detected input devices";
            color: theme-colors.text_secondary;
            font-size: 12px;
            font-weight: 500;
        }

        Rectangle {
            background: theme-colors.bg_tertiary;
            border-radius: 8px;
            height: Math.min(190px, Math.max(96px, root.height * 0.30));
            clip: true;

            Flickable {
                viewport-height: devices-content.preferred-height;
                
                devices-content := VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    if devices.length == 0: Text {
                        text: "No input devices detected.";
                        color: theme-colors.text_muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }

                    for device in devices: Rectangle {
                        height: 44px;
                        background: device-touch.has-hover ? theme-colors.bg_secondary : transparent;
                        border-radius: 6px;

                        device-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;

                                Text {
                                    text: device.name;
                                    color: theme-colors.text_primary;
                                    font-size: 13px;
                                    overflow: elide;
                                }

                                Text {
                                    text: device.blocked ? "Hidden by: " + device.blocked_by : device.id;
                                    color: device.blocked ? theme-colors.warning : theme-colors.text_muted;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 64px;
                                height: 44px;
                                background: transparent;

                                SettingsButton {
                                    y: (parent.height - self.height) / 2;
                                    theme-colors: theme-colors;
                                    label: device.blocked ? "Unhide" : "Hide";
                                    width: 64px;
                                    clicked => {
                                        if device.blocked {
                                            root.unhide-device(device.id);
                                        } else {
                                            root.add-item(device.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Text {
            text: "Saved match patterns";
            color: theme-colors.text_secondary;
            font-size: 12px;
            font-weight: 500;
        }

        HorizontalLayout {
            spacing: 8px;
            SettingsInput {
                theme-colors: theme-colors;
                text <=> new-item-text;
                placeholder-text: "Add pattern or device id";
            }
            SettingsButton {
                theme-colors: theme-colors;
                label: "Add";
                primary: true;
                width: 60px;
                disabled: new-item-text == "";
                clicked => {
                    root.add-item(new-item-text);
                    new-item-text = "";
                }
            }
        }

        // List of items
        Rectangle {
            background: theme-colors.bg_tertiary;
            border-radius: 8px;
            vertical-stretch: 1;
            min-height: 120px;
            clip: true;

            Flickable {
                viewport-height: list-content.preferred-height;
                
                list-content := VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    for item[idx] in blocklist: Rectangle {
                        height: 36px;
                        background: item-touch.has-hover ? theme-colors.bg_secondary : transparent;
                        border-radius: 6px;

                        item-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            alignment: space-between;

                            Text {
                                text: item;
                                color: theme-colors.text_primary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            // Remove button
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: remove-touch.has-hover ? theme-colors.bg_tertiary : transparent;
                                
                                Text {
                                    text: "✕";
                                    width: 100%;
                                    height: 100%;
                                    color: remove-touch.has-hover ? theme-colors.danger : theme-colors.text_muted;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                remove-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.remove-item(idx); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
