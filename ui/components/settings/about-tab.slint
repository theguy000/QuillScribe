import { ThemeColors } from "../../themes/theme-definitions.slint";
import { SettingsField, SettingsHint, SettingsButton } from "shared.slint";

export component AboutTab inherits VerticalLayout {
    in property <ThemeColors> theme-colors;
    in property <string> app-version;
    in-out property <bool> has-update;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <bool> update-checking;
    in-out property <bool> update-downloading;
    in-out property <float> update-progress;
    in-out property <bool> is-linux;

    callback check-for-update();
    callback install-update();

    spacing: 18px;

    // Header
    HorizontalLayout {
        spacing: 14px;
        alignment: start;

        // App icon
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: theme-colors.accent_glow;

            Image {
                source: @image-url("quill.svg");
                colorize: theme-colors.accent;
                width: 32px;
                height: 32px;
                image-fit: contain;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: "QuillScribe";
                color: theme-colors.text_primary;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                text: app-version != "" ? "v" + app-version : "";
                color: theme-colors.text_muted;
                font-size: 12px;
            }
        }
    }

    // Description
    Text {
        text: "Beautiful voice-to-text transcription app. Record your voice, get text instantly using OpenAI's Whisper API or a local model.";
        color: theme-colors.text_secondary;
        font-size: 13px;
        wrap: word-wrap;
    }

    // Divider
    Rectangle {
        height: 1px;
        background: theme-colors.border_light;
    }

    // Updates section
    SettingsField {
        label: "Updates";
        theme-colors: theme-colors;

        VerticalLayout {
            spacing: 8px;

            // Update available card
            if has-update: Rectangle {
                background: theme-colors.accent_glow;
                border-radius: 10px;
                border-width: 1px;
                border-color: theme-colors.accent;

                VerticalLayout {
                    spacing: 8px;
                    padding: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Badge
                        Rectangle {
                            height: 20px;
                            border-radius: 5px;
                            background: theme-colors.accent;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: "New version";
                                    color: theme-colors.on_accent;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "v" + update-version;
                            color: theme-colors.text_primary;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    if update-notes != "": Text {
                        text: update-notes;
                        color: theme-colors.text_secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Linux note
                    if is-linux: Text {
                        text: "Automatic updates aren't supported on Linux. Please update via your package manager or download from GitHub Releases.";
                        color: theme-colors.text_secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Progress bar (non-Linux)
                    if !is-linux && update-downloading: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 200px;
                            height: 6px;
                            border-radius: 3px;
                            background: theme-colors.bg_tertiary;
                            clip: true;

                            Rectangle {
                                width: parent.width * update-progress / 100;
                                height: 100%;
                                border-radius: 3px;
                                background: theme-colors.accent;
                            }
                        }

                        Text {
                            text: update-progress + "%";
                            color: theme-colors.text_secondary;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // Install button (non-Linux, not downloading)
                    if !is-linux && !update-downloading: SettingsButton {
                        theme-colors: theme-colors;
                        label: "Download & Install";
                        primary: true;
                        width: 140px;
                        clicked => { install-update(); }
                    }
                }
            }

            // No update available
            if !has-update: HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                Text {
                    text: "You're on the latest version.";
                    color: theme-colors.text_muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                SettingsButton {
                    theme-colors: theme-colors;
                    label: update-checking ? "Checking..." : "Check for updates";
                    width: 130px;
                    disabled: update-checking;
                    clicked => { check-for-update(); }
                }
            }
        }
    }

    // Divider
    Rectangle {
        height: 1px;
        background: theme-colors.border_light;
    }

    // Project info
    SettingsField {
        label: "Project";
        theme-colors: theme-colors;

        HorizontalLayout {
            spacing: 10px;

            // Info items
            for item in [
                { label: "License", value: "MIT" },
                { label: "Framework", value: "Slint + Rust" },
                { label: "Backend", value: "Rust" }
            ]: Rectangle {
                width: 32px + max(project-label.preferred-width, project-value.preferred-width);
                height: 48px;
                border-radius: 8px;
                background: theme-colors.bg_secondary;

                VerticalLayout {
                    spacing: 4px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 7px;
                    padding-bottom: 7px;

                    project-label := Text {
                        text: item.label;
                        color: theme-colors.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }

                    project-value := Text {
                        text: item.value;
                        color: theme-colors.text_primary;
                        font-size: 12px;
                        font-weight: 500;
                    }
                }
            }
        }
    }

    // Links
    SettingsField {
        label: "Links";
        theme-colors: theme-colors;

        HorizontalLayout {
            spacing: 8px;

            for item in [
                { label: "GitHub", icon: @image-url("../../icons/github.svg") },
                { label: "Report Issue", icon: @image-url("../../icons/alert-circle.svg") }
            ]: Rectangle {
                width: 44px + link-label.preferred-width;
                height: 32px;
                border-radius: 8px;
                background: theme-colors.accent_glow;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 14px;
                        height: 32px;

                        Image {
                            source: item.icon;
                            width: 14px;
                            height: 14px;
                            image-fit: contain;
                            colorize: theme-colors.accent;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    link-label := Text {
                        text: item.label;
                        color: theme-colors.accent;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
