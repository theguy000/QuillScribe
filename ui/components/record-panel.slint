import { ThemeColors } from "../themes/theme-definitions.slint";
import { PanelSurface } from "panel-surface.slint";

component Dot {
    in property <ThemeColors> theme-colors;
    in property <duration> delay;
    property <bool> started: delay == 0ms;

    width: 5px;
    height: 5px;
    opacity: 0.3;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 2.5px;
        background: theme-colors.text_primary;
        opacity: root.opacity;

        Timer {
            interval: root.delay;
            running: !root.started;
            triggered => {
                root.started = true;
                root.opacity = 1.0;
            }
        }

        Timer {
            interval: 600ms;
            running: root.started;
            triggered => {
                root.opacity = root.opacity < 0.5 ? 1.0 : 0.3;
            }
        }

        animate opacity {
            duration: 300ms;
        }
    }
}

component SpinnerArc inherits Path {
    in property <color> arc-color;
    in property <length> arc-stroke-width;
    in property <float> progress;
    in property <float> start;

    property <float> center: 54;
    property <float> radius: 50;
    property <float> start-anchor: start - 0.001;
    property <float> end: start + progress;

    width: 100%;
    height: 100%;
    viewbox-width: 108;
    viewbox-height: 108;
    fill: transparent;
    stroke: arc-color;
    stroke-width: arc-stroke-width;
    stroke-line-cap: round;

    MoveTo {
        x: root.center - root.radius * sin(-root.start-anchor * 360deg);
        y: root.center - root.radius * cos(-root.start-anchor * 360deg);
    }
    LineTo {
        x: root.center - root.radius * sin(-root.start * 360deg);
        y: root.center - root.radius * cos(-root.start * 360deg);
    }
    ArcTo {
        radius-x: root.radius;
        radius-y: root.radius;
        x: root.center - root.radius * sin(-root.end * 360deg);
        y: root.center - root.radius * cos(-root.end * 360deg);
        sweep: true;
        large-arc: false;
    }
}

export component RecordPanel {
    in property <ThemeColors> theme-colors;
    in-out property <bool> is-recording;
    in-out property <bool> is-transcribing;
    in-out property <string> status-message;
    in-out property <float> audio-level;
    in-out property <bool> show-burst: false;

    callback toggle-recording();

    // Errors arrive as "Error: {msg}" (character-count > 6). We exclude every
    // known non-error status. When a new non-error status is added in lib.rs,
    // add it here too to prevent false error detection.
    property <bool> is-error:
        status-message.character-count > 6 &&
        status-message != "Ready" &&
        status-message != "Recording..." &&
        status-message != "Transcribing..." &&
        status-message != "Transcription complete" &&
        status-message != "No speech detected" &&
        status-message != "Ready to record";

    min-width: 300px;
    min-height: 200px;

    PanelSurface {
        width: 100%;
        height: 100%;
        theme-colors: theme-colors;

        VerticalLayout {
            padding: 30px;
            spacing: 16px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                
                Rectangle {
                    width: 128px;
                    height: 128px;

                    property <float> wave-time: 0;
                    property <bool> is-button-down: false;
                    property <duration> press-release-tail: 0ms;
                    property <bool> is-button-pressed: is-button-down || press-release-tail > 0ms;
                    property <length> button-press-offset: is-button-pressed ? 6px : 0px;
                    property <float> button-press-scale: is-button-pressed ? 0.94 : 1.0;
                    property <float> wave-enter-time: 0;
                    property <float> wave-enter-progress: Math.min(wave-enter-time / 180.0, 1.0);

                    animate button-press-offset {
                        duration: is-button-pressed ? 60ms : 130ms;
                        easing: ease-out;
                    }
                    animate button-press-scale {
                        duration: is-button-pressed ? 60ms : 130ms;
                        easing: ease-out;
                    }

                    Timer {
                        interval: 16ms;
                        running: parent.press-release-tail > 0ms;
                        triggered => {
                            parent.press-release-tail = parent.press-release-tail - 16ms;
                        }
                    }

                    Timer {
                        interval: 32ms;
                        running: is-recording;
                        triggered => {
                            parent.wave-time = Math.mod(parent.wave-time + 32.0, 2400.0);
                        }
                    }
                    Timer {
                        interval: 16ms;
                        running: is-recording && parent.wave-enter-time < 180.0;
                        triggered => {
                            parent.wave-enter-time = Math.min(parent.wave-enter-time + 16.0, 180.0);
                        }
                    }
                    Timer {
                        interval: 1ms;
                        running: !is-recording && parent.wave-time > 0;
                        triggered => {
                            parent.wave-time = 0;
                        }
                    }
                    Timer {
                        interval: 1ms;
                        running: !is-recording && parent.wave-enter-time > 0;
                        triggered => {
                            parent.wave-enter-time = 0;
                        }
                    }

                    for i in [0, 1, 2]: Rectangle {
                        property <float> local-time: Math.mod(parent.wave-time + i * 800.0, 2400.0);
                        property <float> progress: self.local-time / 2400.0;
                        property <float> wave-scale: (1.0 + self.progress * 1.2) * (0.88 + parent.wave-enter-progress * 0.12) * parent.button-press-scale;

                        width: 88px * self.wave-scale;
                        height: 88px * self.wave-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + parent.button-press-offset;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: theme-colors.accent;
                        opacity: is-recording ? parent.wave-enter-progress * 0.55 * (1.0 - self.progress) : 0;
                    }

                    property <float> burst-time: 0;
                    property <bool> burst-active: show-burst;
                    Timer {
                        interval: 16ms;
                        running: burst-active;
                        triggered => {
                            parent.burst-time = Math.min(parent.burst-time + 16.0, 700.0);
                        }
                    }
                    Timer {
                        interval: 1ms;
                        running: !burst-active && parent.burst-time > 0;
                        triggered => {
                            parent.burst-time = 0;
                        }
                    }

                    for j in [0, 1, 2]: Rectangle {
                        property <float> ring-delay: j * 80.0;
                        property <bool> ring-started: parent.burst-time >= self.ring-delay;
                        property <float> ring-elapsed: Math.max(parent.burst-time - self.ring-delay, 0.0);
                        property <float> ring-progress: Math.min(self.ring-elapsed / 700.0, 1.0);
                        property <float> ring-scale: (1.0 + self.ring-progress * 1.6) * parent.button-press-scale;

                        width: 80px * self.ring-scale;
                        height: 80px * self.ring-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + parent.button-press-offset;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: theme-colors.accent;
                        opacity: show-burst && self.ring-started ? 0.7 * (1.0 - self.ring-progress) : 0;
                    }

                    Rectangle {
                        property <float> flash-progress: Math.min(parent.burst-time / 600.0, 1.0);
                        property <float> flash-scale: (1.0 + flash-progress * 0.8) * parent.button-press-scale;

                        width: 80px * flash-scale;
                        height: 80px * flash-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + parent.button-press-offset;
                        border-radius: self.width / 2;
                        background: theme-colors.accent_glow;
                        opacity: show-burst ? 0.6 * (1.0 - flash-progress) : 0;
                    }

                    if is-transcribing: Rectangle {
                        width: 108px * parent.button-press-scale;
                        height: 108px * parent.button-press-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + parent.button-press-offset;
                        opacity: 1.0;

                        animate opacity {
                            duration: 180ms;
                            easing: ease-out;
                        }

                        SpinnerArc {
                            arc-color: theme-colors.accent;
                            arc-stroke-width: 3px;
                            progress: 0.318;
                            start: mod(animation-tick(), 2s) / 2s;
                        }

                        SpinnerArc {
                            arc-color: theme-colors.accent_glow;
                            arc-stroke-width: 2.5px;
                            progress: 0.127;
                            start: -mod(animation-tick(), 1200ms) / 1200ms;
                        }
                    }

                    Rectangle {
                        property <float> audio-scale: is-recording ? 1.0 + audio-level * 0.08 : 1.0;
                        property <float> mic-scale: audio-scale * parent.button-press-scale;
                        property <length> resting-shadow-blur: is-recording ? 20px : 30px;
                        property <length> resting-shadow-offset-y: is-recording ? 0px : 16px;

                        width: 88px * mic-scale;
                        height: 88px * mic-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + parent.button-press-offset;
                        border-radius: self.width / 2;
                        background: is-recording ? @linear-gradient(180deg, theme-colors.accent_hover 0%, theme-colors.accent 100%) : @linear-gradient(180deg, theme-colors.bg_primary 0%, theme-colors.bg_secondary 100%);
                        border-width: 1px;
                        border-color: is-recording ? theme-colors.accent : theme-colors.border;
                        drop-shadow-color: is-recording ? theme-colors.accent_glow : theme-colors.shadow;
                        drop-shadow-blur: parent.is-button-pressed ? 12px : resting-shadow-blur;
                        drop-shadow-offset-y: parent.is-button-pressed ? 3px : resting-shadow-offset-y;
                        opacity: is-transcribing ? 0.5 : 1.0;

                        animate mic-scale {
                            duration: parent.is-button-pressed ? 60ms : 130ms;
                            easing: ease-out;
                        }
                        animate drop-shadow-blur {
                            duration: 120ms;
                            easing: ease-out;
                        }
                        animate drop-shadow-offset-y {
                            duration: 120ms;
                            easing: ease-out;
                        }
                        animate background {
                            duration: 200ms;
                        }

                        if is-recording: Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: theme-colors.on_accent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        if !is-recording: Image {
                            source: @image-url("../icons/mic.svg");
                            width: 32px;
                            height: 32px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: theme-colors.text_secondary;
                        }
                    }

                    TouchArea {
                        pointer-event(event) => {
                            if is-transcribing {
                                parent.is-button-down = false;
                                parent.press-release-tail = 0ms;
                            } else if event.kind == PointerEventKind.down {
                                parent.is-button-down = true;
                                parent.press-release-tail = 0ms;
                            } else if event.kind == PointerEventKind.up {
                                if parent.is-button-down {
                                    parent.press-release-tail = 96ms;
                                }
                                parent.is-button-down = false;
                            } else if event.kind == PointerEventKind.cancel {
                                parent.is-button-down = false;
                                parent.press-release-tail = 0ms;
                            }
                        }
                        clicked => {
                            if !is-transcribing {
                                toggle-recording();
                            }
                        }
                        mouse-cursor: is-transcribing ? wait : pointer;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                // Status Title
                HorizontalLayout {
                    alignment: center;
                    
                    if is-transcribing: HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "Transcribing";
                            color: theme-colors.text_primary;
                            font-size: 23px;
                            font-weight: 700;
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                padding-bottom: 2px; // offset for baseline
                                Dot { theme-colors: theme-colors; delay: 0ms; }
                                Dot { theme-colors: theme-colors; delay: 200ms; }
                                Dot { theme-colors: theme-colors; delay: 400ms; }
                            }
                        }
                    }

                    if !is-transcribing: HorizontalLayout {
                        alignment: center;
                        if is-recording: Text {
                            text: "Recording in progress";
                            color: theme-colors.text_primary;
                            font-size: 23px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        if !is-recording && is-error: Text {
                            text: "Something went wrong";
                            color: theme-colors.text_primary;
                            font-size: 23px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        if !is-recording && !is-error: Text {
                            text: "Ready to record";
                            color: theme-colors.text_primary;
                            font-size: 23px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Status Description
                if is-transcribing: Text {
                    text: "Processing your audio. This may take a moment depending on the length of the recording.";
                    color: theme-colors.text_secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if !is-transcribing && is-recording: Text {
                    text: "Click the microphone again to stop and send the captured audio for transcription.";
                    color: theme-colors.text_secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if !is-transcribing && !is-recording && is-error: Text {
                    text: status-message;
                    color: theme-colors.text_secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if !is-transcribing && !is-recording && !is-error: Text {
                    text: "Tap the microphone to start a fresh recording. The transcription result will appear in the panel beside it.";
                    color: theme-colors.text_secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
